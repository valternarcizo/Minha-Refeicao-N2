@startuml DiagramaDominio-v2
skinparam classAttributeIconSize 0
skinparam linetype polyline
skinparam nodesep 60
skinparam ranksep 70
skinparam shadowing false
skinparam defaultFontName Arial
skinparam classBackgroundColor #FFFFFF
skinparam classBorderColor #333333
skinparam ArrowColor #333333
hide empty methods
hide circle
title Diagrama de Classes de Domínio - Assinar Plano de Refeições (versão revisada)

class Assinante {
  celular: String
  dataAceiteTermos: Date
}
class CodigoConfirmacao {
  codigo: String
  dataEnvio: DateTime
  confirmado: Boolean
  numeroTentativas: Integer
}
class Plano {
  nome: String
  quantidadeRefeicoes: Integer
  frequenciaEntrega: String
  valor: Decimal
}
class Assinatura {
  diaSemanaEntrega: String
  dataPrimeiraEntrega: Date
  renovacaoAutomatica: Boolean
  status: StatusAssinatura
}
class PreferenciaAlimentar {
  nome: String
  descricao: String
}
class Cardapio {
  nome: String
}
abstract class ItemCardapio <<abstract>> {
  nome: String
  foto: String
}
class PratoPrincipal
class Acompanhamento
class Sobremesa
class Pedido {
  valorTotal: Decimal
  dataPedido: DateTime
  status: StatusPedido
}
class ItemPedido {
  quantidade: Integer
}
class EnderecoEntrega {
  cep: String
  rua: String
  numero: String
  complemento: String [0..1]
  bairro: String
  cidade: String
  estado: String
}
class Pagamento {
  valor: Decimal
  dataPagamento: DateTime
  codigoAutorizacao: String [0..1]
  status: StatusPagamento
}
class CartaoCredito {
  numero: String
  nomeTitular: String
  validade: String
  cvv: String
  bandeira: String
}
class OperadoraCartao {
  nome: String
}
class Protocolo {
  numero: String
  dataEmissao: DateTime
}

enum StatusAssinatura <<enumeration>> {
  PENDENTE
  ATIVA
  CANCELADA
}
enum StatusPedido <<enumeration>> {
  EM_MONTAGEM
  CONFIRMADO
  ENTREGUE
}
enum StatusPagamento <<enumeration>> {
  PENDENTE
  APROVADO
  RECUSADO
}

' --- Identificação ---
Assinante "1" -- "0..*" CodigoConfirmacao : recebe >

' --- Contratação (classe associativa) ---
Assinante "0..*" -- "0..1" Plano : contrata >
(Assinante, Plano) .. Assinatura

Assinante "0..*" -- "1..*" PreferenciaAlimentar : informa >

' --- Pedido e itens ---
Assinatura "1" -- "1..*" Pedido : gera >
Pedido "1" *-- "1..*" ItemPedido : contém >
ItemPedido "0..*" -- "1" ItemCardapio : refere-se a >
Cardapio "0..*" o-- "1..*" ItemCardapio : oferece >
ItemCardapio <|-- PratoPrincipal
ItemCardapio <|-- Acompanhamento
ItemCardapio <|-- Sobremesa
Pedido "0..*" -- "1" EnderecoEntrega : é entregue em >

' --- Pagamento ---
Assinatura "1" -- "0..*" Pagamento : é paga por >
Pagamento "0..*" -- "1" CartaoCredito : utiliza >
OperadoraCartao "1" -- "0..*" Pagamento : autoriza >
Assinatura "1" -- "0..1" Protocolo : gera >

@enduml
